# Скопируйте в .env и заполните.  Copy to .env and fill in.
# .env закоммичен НЕ будет — он в .gitignore.

# --- LLM provider keys ------------------------------------------------------
# Нужен минимум один. Ключи прокидываются внутрь воркеров как env.
# Ключи, заданные в UI (страница «Провайдеры»), имеют приоритет над этими.
# At least one is required. Keys set in the UI take precedence over these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Другие провайдеры opencode подхватываются по тому же шаблону <PROVIDER>_API_KEY:
# GROQ_API_KEY, XAI_API_KEY, OPENROUTER_API_KEY, MISTRAL_API_KEY, ...

# --- broker -----------------------------------------------------------------
# Порт брокера. По умолчанию compose публикует его ТОЛЬКО на 127.0.0.1 —
# см. SECURITY.md перед тем, как выставлять наружу.
VIBEPROD_PORT=8000

# Интерфейс публикации порта. 127.0.0.1 — только локально (SSH-туннель).
# 0.0.0.0 — наружу: обязательно задайте VIBEPROD_LOGIN/VIBEPROD_PASSWORD.
# VIBEPROD_BIND=0.0.0.0

# Таймзона для cron-расписаний.
VIBEPROD_TZ=Europe/Moscow

# Минут простоя, после которых контейнер воркера убивается.
VIBEPROD_IDLE_TTL_MIN=120

# Модель по умолчанию для первого агента при инициализации базы.
VIBEPROD_DEFAULT_MODEL=deepseek/deepseek-chat

# --- образы и пути ----------------------------------------------------------
# Базовый образ opencode, поверх которого собирается воркер.
VIBEPROD_OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:latest

# Каталог данных (sqlite + workspaces) внутри процесса брокера.
# VIBEPROD_DATA_DIR=./data

# Тот же каталог в системе координат docker-демона. Нужен, только когда брокер
# сам запущен в контейнере (compose подставляет автоматически).
# VIBEPROD_HOST_DATA_DIR=

# URL guardian MCP, по которому его видят воркеры.
# VIBEPROD_GUARDIAN_URL=http://host.docker.internal:8000/guardian/mcp

# --- Авторизация UI (необязательно) ------------------------------------------
# Если оба значения заданы, веб-интерфейс и /api потребуют входа.
# Если пусто — авторизация отключена. Guardian MCP и вебхуки работают как раньше
# (у них свои секреты).
# VIBEPROD_LOGIN=admin
# VIBEPROD_PASSWORD=change-me

# --- Telegram (необязательно) -----------------------------------------------
# Фолбэк на первый запуск: обычно бот настраивается в UI (Автоматизация → Каналы).
# Fallback for first boot; normally configured in the UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_WEB_URL=

# --- MinIO: файлы проектов ---------------------------------------------------
# Файлы проектов (раздел «Файлы», скриншоты playwright) хранятся в MinIO.
# Для локального dev дефолты подходят: minioadmin/minioadmin, http://127.0.0.1:9000.
# В compose брокеру автоматически подставляется http://vibeprod-minio:9000.
VIBEPROD_S3_ENDPOINT=http://127.0.0.1:9000
VIBEPROD_S3_ACCESS_KEY=minioadmin
VIBEPROD_S3_SECRET_KEY=minioadmin

# Креды самого контейнера MinIO (совпадают с S3-доступом брокера).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# URL брокера, который воркеры вставляют в ссылки на файлы проекта.
# По умолчанию http://host.docker.internal:<VIBEPROD_PORT>.
# VIBEPROD_BROKER_URL=
